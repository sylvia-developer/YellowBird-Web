# Backend (must match CLIENT_URL origin in yellowbird-api/.env)
VITE_API_URL=http://localhost:3000

# Firebase web app — Firebase Console → Project settings → Your apps → Web
# Full guide: ../yellowbird-api/FIREBASE_SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: local Auth emulator (requires Firebase CLI emulators)
# VITE_FIREBASE_USE_EMULATOR=true

VITE_WHATSAPP_NUMBER=256700000000